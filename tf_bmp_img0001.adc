# DMZ-EG4S20 keypad: hardware introductory guide p7 and Exp12.adc agree.
# Open-drain rows; physical 10k column pullups. Do not swap E10/E11.
set_pin_assignment { key_row[0] } { LOCATION = E10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_row[1] } { LOCATION = C10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_row[2] } { LOCATION = F9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_row[3] } { LOCATION = D9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_col[0] } { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_col[1] } { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_col[2] } { LOCATION = C11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key_col[3] } { LOCATION = F10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
